# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
# 构建产物目录，不入库（仓库根 dist/ 是 pack.sh 的发行包输出）
/dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores Visual Studio Code versions used for testing Visual Studio Code extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Astro generated types
.astro/

# Turbo Repo
.turbo

/server/stream-cache/

# 运行时状态文件（机器本地生成，不入库；同目录的 config.json 与
# content-config.json 是入库的模板配置）。设备标识（device_id）与链路
# 密钥同存于 apikeys.json，均为本机长期状态
/server/config/apikeys.json

# ---------- Node 后端 ----------
# Node 后端是纯 JS 源码，直接 node 运行，没有编译产物需要忽略。

# pack.sh 的打包产物（7 个平台的发行 zip，约 450MB）落在仓库根的 dist/。
# 上文第 84 行的 `/dist` 已锚定根目录并覆盖此处，此处补充说明以防误删。
/dist/

# ---------- Node 运行时 ----------
# Node 运行时不再随仓库入库：仓库体积曾因此达到 296MB，而克隆者多数并不需要它。
# 发行包由 scripts/pack.sh 动态下载对应平台的 Node 并打入包内，开箱即用；
# 从源码运行时则依赖系统 Node，或自行把 Node 解压到 node/（启动脚本会自动发现）。
/node/

# pack.sh 下载的 Node 运行时缓存（约 370MB / 7 个平台），纯本地中间产物
/.pack-cache/

# 剧集下载产物（download/<剧名>/第N集.mp4），运行时生成
/download/
